# teabot settings. Copy to teabot.env and fill in the blanks.
# Every name starts with TEABOT_. Variables set in the environment win over this file.

# Discord
TEABOT_DISCORD_TOKEN=
# Readable logs and asyncio debug checks.
TEABOT_DEV_MODE=false

# Postgres. `teabot init` creates the roles and fills in the passwords.
TEABOT_DB_HOST=127.0.0.1
TEABOT_DB_PORT=5432
TEABOT_DB_NAME=teabot
TEABOT_DB_OWNER_USER=teabot_owner
# Prefix of the app, plugins and per-plugin role names. Change it to share one Postgres server.
TEABOT_DB_ROLE_PREFIX=teabot
# With Docker Compose, leave this blank: Compose passes the one in .env.
TEABOT_DB_OWNER_PASSWORD=
TEABOT_DB_APP_PASSWORD=
TEABOT_DB_PLUGINS_PASSWORD=
TEABOT_DB_POOL_SIZE=10

# HTTP for MCP and the service API. Keep it on localhost behind a reverse proxy.
TEABOT_HTTP_HOST=127.0.0.1
TEABOT_HTTP_PORT=8780
TEABOT_PUBLIC_URL=

# Plugins blocked everywhere, comma-separated.
TEABOT_DISABLED_PLUGINS=
# Days a server's data is kept after the bot leaves it.
TEABOT_GUILD_RETENTION_DAYS=30

# Logging: DEBUG, INFO, WARNING or ERROR; format auto, text or json.
TEABOT_LOG_LEVEL=INFO
TEABOT_LOG_FORMAT=auto
