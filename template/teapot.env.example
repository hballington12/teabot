# teapot settings. Copy to teapot.env and fill in the blanks.
# Every name starts with TEAPOT_. Variables set in the environment win over this file.

# Discord
TEAPOT_DISCORD_TOKEN=
# A test server where commands register instantly. Development only.
TEAPOT_DEV_GUILD_ID=
# Readable logs and asyncio debug checks.
TEAPOT_DEV_MODE=false

# Postgres (D9, D30). `teapot init` creates the roles and fills in the passwords.
TEAPOT_DB_HOST=127.0.0.1
TEAPOT_DB_PORT=5432
TEAPOT_DB_NAME=teapot
TEAPOT_DB_OWNER_USER=teapot_owner
TEAPOT_DB_OWNER_PASSWORD=
TEAPOT_DB_APP_PASSWORD=
TEAPOT_DB_PLUGINS_PASSWORD=
TEAPOT_DB_POOL_SIZE=10

# HTTP for MCP and the service API (D36). Keep it on localhost behind a reverse proxy.
TEAPOT_HTTP_HOST=127.0.0.1
TEAPOT_HTTP_PORT=8780
TEAPOT_PUBLIC_URL=

# Plugins blocked everywhere, comma-separated (D13).
TEAPOT_DISABLED_PLUGINS=
# Days a server's data is kept after the bot leaves it (D49).
TEAPOT_GUILD_RETENTION_DAYS=30

# Logging: DEBUG, INFO, WARNING or ERROR; format auto, text or json.
TEAPOT_LOG_LEVEL=INFO
TEAPOT_LOG_FORMAT=auto
