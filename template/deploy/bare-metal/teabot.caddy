# teabot's Caddy site block. setup-host.sh installs it as /etc/caddy/teabot.caddy with the real
# hostname in place of teabot.example.org, and imports it from the main Caddyfile.
# Everything reaches teabot, its site, /mcp and /api, except /healthz, which stays on localhost. Caddy passes the
# original Host header through, which the MCP server checks.
teabot.example.org {
	handle /healthz {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:8780
	}
}
