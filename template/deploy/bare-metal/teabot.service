# teabot on a bare-metal host (D37). Installed by setup-host.sh as /etc/systemd/system/teabot.service.
# The code lives in /opt/teabot, synced by deploy.sh; secrets live in /etc/teabot/teabot.env.
[Unit]
Description=teabot Discord bot
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
User=teabot
Group=teabot
WorkingDirectory=/opt/teabot
ExecStart=/opt/teabot/.venv/bin/teabot run --env-file /etc/teabot/teabot.env
Environment=PYTHONUNBUFFERED=1
# A lost lock connection or a crash exits with an error; systemd starts it again (D40).
Restart=on-failure
RestartSec=5
# teabot stops its shards, workers and HTTP server on SIGTERM; give it time to finish a job's step.
TimeoutStopSec=30

# Hardening: teabot needs the network, its code and its env file, and writes nothing to disk.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
