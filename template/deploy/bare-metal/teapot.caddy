# teapot's Caddy site block (D36, D37). setup-host.sh installs it as /etc/caddy/teapot.caddy with the real
# hostname in place of teapot.example.org, and imports it from the main Caddyfile.
# Only /mcp and /api reach teapot. /healthz and everything else stay on localhost. Caddy passes the
# original Host header through, which the MCP server checks (S5).
teapot.example.org {
	handle /mcp {
		reverse_proxy 127.0.0.1:8780
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8780
	}
	handle {
		respond 404
	}
}
