# One pgBackRest backup of the teabot stanza; %i is the type, `full` or `diff`. Started by the timers.
[Unit]
Description=pgBackRest %i backup of teabot
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/pgbackrest --stanza=teabot --type=%i backup
